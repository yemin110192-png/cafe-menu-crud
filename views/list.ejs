<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>카페 메뉴 목록</title>
</head>
<body>
    <h2>카페 메뉴 목록</h2>
    <a href="/add">메뉴 추가하기</a>
    <br><br>

    <table border="1">
        <tr>
            <th>ID</th>
            <th>메뉴명</th>
            <th>가격</th>
            <th>카테고리</th>
            <th>관리</th>
        </tr>
        <% for(var i = 0; i < list.length; i++) { %>
        <tr>
            <td><%= list[i].id %></td>
            <td><%= list[i].name %></td>
            <td><%= list[i].price %>원</td>
            <td><%= list[i].category %></td>
            <td>
                <a href="/edit/<%= list[i].id %>">수정</a>
                <form action="/delete/<%= list[i].id %>" method="post" style="display:inline;">
   			 <input type="submit" value="삭제">
		</form>
            </td>
        </tr>
        <% } %>
    </table>
</body>
</html>
